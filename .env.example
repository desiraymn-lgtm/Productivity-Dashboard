# Copy this file to .env.local and fill in your Neon connection string.
# Find it in the Neon console: https://console.neon.tech -> your project -> Connection Details
# Use the "pooled connection" string for serverless/Vercel deployments.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
